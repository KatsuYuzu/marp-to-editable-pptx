		{
			"label": "read-structural-tofu",
			"type": "shell",
			"command": "node -e \"const fs=require('fs');const f='dist/vr-batch/structural-tofu.json';try{const d=JSON.parse(fs.readFileSync(f,'utf8'));console.log('Slides:',d.slides,'FAIL:',d.summary.FAIL,'WARN:',d.summary.WARN,'OK:',d.summary.OK);const issues=d.perSlide.filter(s=>s.overall!=='OK');issues.slice(0,10).forEach(s=>{const det=s.details;const info=[det.fontIssues?.length?'font:'+det.fontIssues[0]:'',det.codeFormatIssues?.length?'code:'+det.codeFormatIssues[0]:'',det.contentMissingPct>'5'?'content:'+det.contentMissingPct+'%':''].filter(Boolean).join(', ');console.log('  Slide',s.slide,'['+s.overall+']',info||JSON.stringify(det).slice(0,100))})}catch(e){console.log('Error:',e.message);console.log(fs.readFileSync(f,'utf8').slice(0,300))}\""
