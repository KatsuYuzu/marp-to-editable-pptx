			"label": "read-structural-result",
			"type": "shell",
			"command": "node -e \"const fs=require('fs');const f='dist/vr-batch/structural-AI\\u6d3b\\u52d5\\u5831\\u544a.json';if(fs.existsSync(f)){const d=JSON.parse(fs.readFileSync(f,'utf8'));console.log('Slides:',d.slides,'FAIL:',d.summary.FAIL,'WARN:',d.summary.WARN,'OK:',d.summary.OK);const fails=d.perSlide.filter(s=>s.overall==='FAIL');fails.slice(0,5).forEach(s=>console.log('  Slide',s.slide,JSON.stringify(s.details)))}else{const content=fs.readFileSync(f.replace('.json','.json'),'utf8');console.log(content.slice(0,500))}\""
